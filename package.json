{
  "name": "graph-engineering-workspace",
  "version": "0.0.0",
  "private": true,
  "files": [
    "README.md",
    "LICENSE"
  ],
  "description": "Vendor-neutral durable graph orchestration for multi-agent systems",
  "keywords": ["ai", "agents", "multi-agent", "graph", "workflow", "orchestration"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reacher-z/GraphEngineering.git"
  },
  "homepage": "https://github.com/reacher-z/GraphEngineering#readme",
  "bugs": { "url": "https://github.com/reacher-z/GraphEngineering/issues" },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.12"
    }
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:packages": "node scripts/check-package-contents.mjs",
    "check:packed-install": "node scripts/check-packed-install.mjs",
    "audit:prod": "corepack pnpm audit --prod --audit-level moderate",
    "check:python-package": "python3 scripts/check-python-artifacts.py",
    "test:python": "uv run --project python pytest",
    "test:conformance": "corepack pnpm --filter @graph-engineering/core build && corepack pnpm --filter @graph-engineering/persistence build && corepack pnpm --filter @graph-engineering/runtime build && corepack pnpm --filter @graph-engineering/primitives build && node tools/conformance/run.mjs"
  }
}
