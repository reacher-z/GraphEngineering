{
  "apiVersion": "graphengineering.reacher-z.github.io/v1alpha1",
  "kind": "Graph",
  "metadata": {
    "name": "course-module-02-chain-flaky-format",
    "version": "1.0.0",
    "description": "Exercise 1 solution: the teaching chain with the flake and the retry declaration moved to the format node"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["bulletin"],
    "properties": {
      "bulletin": { "type": "string", "minLength": 1 }
    }
  },
  "outputSchema": {
    "type": "object"
  },
  "entrypoints": ["extract"],
  "outputs": {
    "report": { "node": "format" }
  },
  "nodes": [
    {
      "id": "extract",
      "kind": "transform",
      "inputSchema": { "type": "object" },
      "outputSchema": { "type": "object" },
      "config": { "operation": "extract" },
      "sideEffects": "none"
    },
    {
      "id": "enrich",
      "kind": "agent",
      "inputSchema": { "type": "object" },
      "outputSchema": { "type": "object" },
      "config": { "role": "Tag the extracted headline" },
      "sideEffects": "none"
    },
    {
      "id": "format",
      "kind": "transform",
      "inputSchema": { "type": "object" },
      "outputSchema": { "type": "object" },
      "config": { "operation": "format" },
      "retry": { "maxAttempts": 2 },
      "sideEffects": "none"
    }
  ],
  "edges": [
    {
      "id": "extract-enrich",
      "from": { "node": "extract" },
      "to": { "node": "enrich", "port": "extracted" },
      "mode": "value"
    },
    {
      "id": "enrich-format",
      "from": { "node": "enrich" },
      "to": { "node": "format", "port": "enriched" },
      "mode": "value"
    }
  ],
  "policies": {
    "maxConcurrency": 1,
    "maxDepth": 8,
    "maxFanOut": 2,
    "maxTotalAttempts": 6
  }
}
