{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph.schema.json",
  "title": "Graph Engineering Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "inputSchema", "outputSchema", "entrypoints", "outputs", "nodes", "edges"],
  "properties": {
    "apiVersion": { "const": "graphengineering.reacher-z.github.io/v1alpha1" },
    "kind": { "const": "Graph" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "inputSchema": { "$ref": "#/$defs/jsonSchema" },
    "outputSchema": { "$ref": "#/$defs/jsonSchema" },
    "stateSchema": { "$ref": "#/$defs/jsonSchema" },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/endpoint" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "policies": { "$ref": "#/$defs/policies" }
  },
  "$defs": {
    "jsonSchema": { "type": "object" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "port": { "type": "string", "minLength": 1 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "initialDelayMs": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "maxDelayMs": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "backoffMultiplier": { "type": "number", "minimum": 1 },
        "jitter": { "type": "boolean" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "inputSchema", "outputSchema", "config"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
        "kind": {
          "enum": ["agent", "model", "tool", "transform", "subgraph", "router", "barrier", "validator", "human"]
        },
        "inputSchema": { "$ref": "#/$defs/jsonSchema" },
        "outputSchema": { "$ref": "#/$defs/jsonSchema" },
        "config": {},
        "retry": { "$ref": "#/$defs/retry" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "cache": { "type": "object" },
        "resources": { "type": "object" },
        "isolation": { "type": "object" },
        "sideEffects": { "enum": ["none", "idempotent", "non-idempotent"] }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "map": { "type": "object" },
        "condition": { "type": "object" },
        "mode": { "enum": ["value", "stream", "artifact-ref"] },
        "schema": { "$ref": "#/$defs/jsonSchema" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxDynamicNodes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxFanOut": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxTotalAttempts": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "maxCostUsd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
