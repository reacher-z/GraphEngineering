{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/checkpoint.schema.json",
  "title": "Graph Engineering Stored Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "runId",
    "checkpointId",
    "sequence",
    "createdAt",
    "state",
    "contentHash"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/checkpoints/v1alpha1"
    },
    "runId": { "$ref": "#/$defs/safeIdentifier" },
    "checkpointId": { "$ref": "#/$defs/safeIdentifier" },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "state": { "$ref": "#/$defs/portableJson" },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": { "enum": [".", ".."] }
    },
    "portableJson": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/portableJson" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/portableJson" }
        }
      ]
    }
  }
}
