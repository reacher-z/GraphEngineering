{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/subgraph-edge-checkpoint.schema.json",
  "title": "Graph Engineering Subgraph and Edge Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "contractVersion",
    "runId",
    "eventStreamId",
    "revisionHash",
    "lineage",
    "checkpointId",
    "planHash",
    "rootGraphHash",
    "sequence",
    "historyPrefixHash",
    "createdAt",
    "payloadDisposition",
    "redacted",
    "invocations",
    "reducers",
    "artifacts",
    "streams",
    "trace",
    "contentHash"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/subgraph-edge-checkpoints/v1alpha1"
    },
    "kind": { "const": "SubgraphEdgeCheckpoint" },
    "contractVersion": { "const": "subgraph-edge-recovery/v1alpha1" },
    "runId": { "$ref": "#/$defs/identifier" },
    "eventStreamId": { "$ref": "#/$defs/hash" },
    "revisionHash": { "$ref": "#/$defs/hash" },
    "lineage": { "$ref": "#/$defs/runLineage" },
    "checkpointId": { "$ref": "#/$defs/identifier" },
    "planHash": { "$ref": "#/$defs/hash" },
    "rootGraphHash": { "$ref": "#/$defs/hash" },
    "sequence": { "$ref": "#/$defs/safeNonNegativeInteger" },
    "historyPrefixHash": { "$ref": "#/$defs/hash" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "payloadDisposition": { "const": "inline-unredacted" },
    "redacted": { "const": false },
    "invocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/invocationProjection" }
    },
    "reducers": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/reducerProjection" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/artifactProjection" }
    },
    "streams": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/streamProjection" }
    },
    "trace": { "$ref": "#/$defs/traceProjection" },
    "contentHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "graphKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "runLineage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "start" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "sourceRunId", "sourceSequence", "sourceHistoryHash"],
          "properties": {
            "mode": { "enum": ["resume", "replay", "fork"] },
            "sourceRunId": { "$ref": "#/$defs/identifier" },
            "sourceSequence": { "$ref": "#/$defs/safeNonNegativeInteger" },
            "sourceHistoryHash": { "$ref": "#/$defs/hash" }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "invocationId",
        "parentInvocationId",
        "graphKey",
        "graphHash",
        "compiledPlanHash",
        "graphRevision",
        "depth",
        "callId",
        "callOrdinal",
        "recursionGroup",
        "recursionDepth"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "invocationId": { "$ref": "#/$defs/hash" },
        "parentInvocationId": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/hash" }
          ]
        },
        "graphKey": { "$ref": "#/$defs/graphKey" },
        "graphHash": { "$ref": "#/$defs/hash" },
        "compiledPlanHash": { "$ref": "#/$defs/hash" },
        "graphRevision": { "const": 1 },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "callId": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        },
        "callOrdinal": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "recursionGroup": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        },
        "recursionDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "failureCode": {
      "enum": [
        "GE_D4_CAPABILITY_UNAVAILABLE",
        "GE_D4_PLAN_INVALID",
        "GE_D4_NAMESPACE_INVALID",
        "GE_D4_RECURSION_LIMIT",
        "GE_D4_PROJECTION_MISSING",
        "GE_D4_PROJECTION_COLLISION",
        "GE_D4_REDUCER_CONFLICT",
        "GE_D4_REDUCER_IDEMPOTENCY_CONFLICT",
        "GE_D4_ARTIFACT_STORE_UNAVAILABLE",
        "GE_D4_ARTIFACT_PUBLICATION_FAILED",
        "GE_D4_ARTIFACT_NOT_FOUND",
        "GE_D4_ARTIFACT_CORRUPT",
        "GE_D4_ARTIFACT_UNAUTHORIZED",
        "GE_D4_ARTIFACT_OVERSIZED",
        "GE_D4_ARTIFACT_EXPIRED",
        "GE_D4_STREAM_DEMAND_EXHAUSTED",
        "GE_D4_STREAM_BUFFER_FULL",
        "GE_D4_STREAM_ITEM_INVALID",
        "GE_D4_STREAM_PROTOCOL",
        "GE_D4_STREAM_CANCELLED",
        "GE_D4_STREAM_FAILED",
        "GE_D4_PAYLOAD_POLICY_UNAVAILABLE",
        "GE_D4_INVALID_HISTORY",
        "GE_D4_CORRUPT_CHECKPOINT"
      ]
    },
    "invocationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "status",
        "inputHash",
        "effectiveAuthorityHash",
        "budgetAllocationHash",
        "reuseDisposition"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "status": {
          "enum": ["created", "running", "succeeded", "failed", "cancelled"]
        },
        "inputHash": { "$ref": "#/$defs/hash" },
        "effectiveAuthorityHash": { "$ref": "#/$defs/hash" },
        "budgetAllocationHash": { "$ref": "#/$defs/hash" },
        "reuseDisposition": { "enum": ["new-work", "committed-exact-reuse"] },
        "projectedOutputHash": { "$ref": "#/$defs/hash" },
        "failureCode": { "$ref": "#/$defs/failureCode" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "status": { "const": "succeeded" } }
          },
          "then": {
            "type": "object",
            "properties": { "projectedOutputHash": {} },
            "required": ["projectedOutputHash"],
            "not": {
              "type": "object",
              "properties": { "failureCode": {} },
              "required": ["failureCode"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": { "enum": ["failed", "cancelled"] }
            }
          },
          "then": {
            "type": "object",
            "properties": { "failureCode": {} },
            "required": ["failureCode"],
            "not": {
              "type": "object",
              "properties": { "projectedOutputHash": {} },
              "required": ["projectedOutputHash"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": { "enum": ["created", "running"] }
            }
          },
          "then": {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": { "projectedOutputHash": {} },
                  "required": ["projectedOutputHash"]
                },
                {
                  "type": "object",
                  "properties": { "failureCode": {} },
                  "required": ["failureCode"]
                }
              ]
            }
          }
        }
      ]
    },
    "reducerProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "reducerId",
        "reducerIdentity",
        "stateVersion",
        "state",
        "stateHash",
        "lastBatchId"
      ],
      "properties": {
        "invocationId": { "$ref": "#/$defs/hash" },
        "reducerId": { "$ref": "#/$defs/identifier" },
        "reducerIdentity": { "$ref": "#/$defs/hash" },
        "stateVersion": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "state": {},
        "stateHash": { "$ref": "#/$defs/hash" },
        "lastBatchId": { "$ref": "#/$defs/hash" }
      }
    },
    "artifactProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRef",
        "verifiedBy",
        "activeHolds",
        "releaseRecorded",
        "eligibleForGc"
      ],
      "properties": {
        "artifactRef": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/artifact-ref.schema.json"
        },
        "verifiedBy": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "activeHolds": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "releaseRecorded": { "type": "boolean" },
        "eligibleForGc": { "type": "boolean" }
      }
    },
    "traceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traceId",
        "throughSequence",
        "normalizedTraceHash",
        "openSpanIds",
        "completedSpanIds",
        "droppedSpans",
        "externalExport"
      ],
      "properties": {
        "traceId": { "$ref": "#/$defs/hash" },
        "throughSequence": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "normalizedTraceHash": { "$ref": "#/$defs/hash" },
        "openSpanIds": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash" }
        },
        "completedSpanIds": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash" }
        },
        "droppedSpans": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "externalExport": { "const": "off-by-default" }
      }
    },
    "streamProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamId",
        "invocationId",
        "edgeId",
        "status",
        "itemMode",
        "itemSchemaHash",
        "topology",
        "maxItems",
        "maxItemBytes",
        "maxInFlightBytes",
        "currentInFlightBytes",
        "bufferCapacity",
        "maxUnacknowledged",
        "totalDemand",
        "published",
        "delivered",
        "acknowledged",
        "sourceClosed",
        "bufferedItemSequences",
        "unacknowledgedItemSequences"
      ],
      "properties": {
        "streamId": { "$ref": "#/$defs/hash" },
        "invocationId": { "$ref": "#/$defs/hash" },
        "edgeId": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["open", "source-closed", "completed", "failed", "cancelled"] },
        "itemMode": { "enum": ["value", "artifact-ref"] },
        "itemSchemaHash": { "$ref": "#/$defs/hash" },
        "topology": { "const": "one-to-one" },
        "maxItems": { "$ref": "#/$defs/safePositiveInteger" },
        "maxItemBytes": { "$ref": "#/$defs/safePositiveInteger" },
        "maxInFlightBytes": { "$ref": "#/$defs/safePositiveInteger" },
        "currentInFlightBytes": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "bufferCapacity": { "$ref": "#/$defs/safePositiveInteger" },
        "maxUnacknowledged": { "$ref": "#/$defs/safePositiveInteger" },
        "totalDemand": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "published": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "delivered": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "acknowledged": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "sourceClosed": { "type": "boolean" },
        "bufferedItemSequences": {
          "type": "array",
          "maxItems": 65536,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeNonNegativeInteger" }
        },
        "unacknowledgedItemSequences": {
          "type": "array",
          "maxItems": 65536,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeNonNegativeInteger" }
        },
        "failureCode": { "$ref": "#/$defs/failureCode" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "status": { "enum": ["failed", "cancelled"] } }
          },
          "then": {
            "type": "object",
            "properties": { "failureCode": {} },
            "required": ["failureCode"]
          },
          "else": {
            "not": {
              "type": "object",
              "properties": { "failureCode": {} },
              "required": ["failureCode"]
            }
          }
        }
      ]
    }
  }
}
