{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json",
  "title": "Graph Engineering durable cycle-controller event",
  "description": "Closed append-only event envelope for cycle-controller-recovery/v1alpha1. Payloads are truthfully inline-unredacted; this schema is not D9 protected-payload evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "contractVersion",
    "eventId",
    "type",
    "timestamp",
    "controllerRunId",
    "hostRunId",
    "controllerHash",
    "requestHash",
    "graphRevision",
    "sequence",
    "expectedPreviousSequence",
    "previousEventHash",
    "lease",
    "payloadDisposition",
    "redacted",
    "payloadHash",
    "data",
    "recordHash"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/cycle-controller-events/v1alpha1"
    },
    "contractVersion": { "const": "cycle-controller-recovery/v1alpha1" },
    "eventId": { "$ref": "#/$defs/identifier" },
    "type": {
      "enum": [
        "ControllerCreated",
        "LeaseAcquired",
        "LeaseRenewed",
        "LeaseReleased",
        "RoundReserved",
        "ActivityStarted",
        "ActivityFailed",
        "DiscoveryCommitted",
        "CandidateEvaluationCommitted",
        "ModeOutcomeCommitted",
        "BudgetReservationSettled",
        "BudgetReservationReleased",
        "PatchAccepted",
        "PatchRejected",
        "RoundCommitted",
        "ControllerTerminated"
      ]
    },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "controllerRunId": { "$ref": "#/$defs/identifier" },
    "hostRunId": { "$ref": "#/$defs/identifier" },
    "controllerHash": { "$ref": "#/$defs/hash" },
    "requestHash": { "$ref": "#/$defs/hash" },
    "graphRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": { "$ref": "#/$defs/counter" },
    "expectedPreviousSequence": {
      "type": "integer",
      "minimum": -1,
      "maximum": 9007199254740990
    },
    "previousEventHash": {
      "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "lease": {
      "oneOf": [{ "$ref": "#/$defs/lease" }, { "type": "null" }]
    },
    "payloadDisposition": { "const": "inline-unredacted" },
    "redacted": { "const": false },
    "payloadHash": { "$ref": "#/$defs/hash" },
    "data": { "type": "object" },
    "recordHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "ControllerCreated" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "sequence": { "const": 0 },
          "expectedPreviousSequence": { "const": -1 },
          "previousEventHash": { "type": "null" },
          "lease": { "type": "null" },
          "data": { "$ref": "#/$defs/controllerCreatedData" }
        }
      },
      "else": {
        "properties": { "lease": { "$ref": "#/$defs/lease" } }
      }
    }
  ],
  "oneOf": [
    {
      "properties": {
        "type": { "const": "ControllerCreated" },
        "data": { "$ref": "#/$defs/controllerCreatedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "LeaseAcquired" },
        "data": { "$ref": "#/$defs/leaseAcquiredData" }
      }
    },
    {
      "properties": {
        "type": { "const": "LeaseRenewed" },
        "data": { "$ref": "#/$defs/leaseRenewedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "LeaseReleased" },
        "data": { "$ref": "#/$defs/leaseReleasedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "RoundReserved" },
        "data": { "$ref": "#/$defs/roundReservedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "ActivityStarted" },
        "data": { "$ref": "#/$defs/activityStartedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "ActivityFailed" },
        "data": { "$ref": "#/$defs/activityFailedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "DiscoveryCommitted" },
        "data": { "$ref": "#/$defs/discoveryCommittedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "CandidateEvaluationCommitted" },
        "data": { "$ref": "#/$defs/candidateEvaluationCommittedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "ModeOutcomeCommitted" },
        "data": { "$ref": "#/$defs/modeOutcomeCommittedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "BudgetReservationSettled" },
        "data": { "$ref": "#/$defs/budgetReservationSettledData" }
      }
    },
    {
      "properties": {
        "type": { "const": "BudgetReservationReleased" },
        "data": { "$ref": "#/$defs/budgetReservationReleasedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "PatchAccepted" },
        "data": { "$ref": "#/$defs/patchAcceptedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "PatchRejected" },
        "data": { "$ref": "#/$defs/patchRejectedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "RoundCommitted" },
        "data": { "$ref": "#/$defs/roundCommittedData" }
      }
    },
    {
      "properties": {
        "type": { "const": "ControllerTerminated" },
        "data": { "$ref": "#/$defs/controllerTerminatedData" }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": { "enum": [".", ".."] }
    },
    "versionedIdentity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}/v[0-9]+(?:alpha[0-9]+|beta[0-9]+)?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveCounter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cost": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseId", "holderId", "leaseEpoch", "fencingToken", "acquiredAt", "expiresAt"],
      "properties": {
        "leaseId": { "$ref": "#/$defs/identifier" },
        "holderId": { "$ref": "#/$defs/identifier" },
        "leaseEpoch": { "$ref": "#/$defs/positiveCounter" },
        "fencingToken": { "$ref": "#/$defs/positiveCounter" },
        "acquiredAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "graphCoordinate": {
      "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph-revision.schema.json#/$defs/coordinate"
    },
    "inlinePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "redacted", "encoding", "canonicalJson", "utf8ByteLength", "sha256"],
      "properties": {
        "disposition": { "const": "inline-unredacted" },
        "redacted": { "const": false },
        "encoding": { "const": "canonical-json/v1alpha1" },
        "canonicalJson": { "type": "string", "minLength": 1, "maxLength": 16777216 },
        "utf8ByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "patchPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "redacted", "encoding", "canonicalJson", "utf8ByteLength", "sha256"],
      "properties": {
        "disposition": { "const": "inline-unredacted" },
        "redacted": { "const": false },
        "encoding": { "const": "canonical-json/v1alpha1" },
        "canonicalJson": { "type": "string", "minLength": 1, "maxLength": 4194304 },
        "utf8ByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "budgetDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "costUsd", "dynamicNodes"],
      "properties": {
        "attempts": { "$ref": "#/$defs/counter" },
        "costUsd": { "$ref": "#/$defs/cost" },
        "dynamicNodes": { "$ref": "#/$defs/counter" }
      }
    },
    "budgetTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptsCommitted", "costUsdCommitted", "dynamicNodesCommitted", "liveReservations"],
      "properties": {
        "attemptsCommitted": { "$ref": "#/$defs/counter" },
        "costUsdCommitted": { "$ref": "#/$defs/cost" },
        "dynamicNodesCommitted": { "$ref": "#/$defs/counter" },
        "liveReservations": { "$ref": "#/$defs/budgetDelta" }
      }
    },
    "activityPhase": {
      "enum": ["finder", "candidate-evaluator", "condition", "optimizer-evaluator", "patch-planner"]
    },
    "activityReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "activityId", "maxAttempts", "maxCostUsd"],
      "properties": {
        "phase": { "$ref": "#/$defs/activityPhase" },
        "activityId": { "$ref": "#/$defs/identifier" },
        "maxAttempts": { "$ref": "#/$defs/positiveCounter" },
        "maxCostUsd": { "$ref": "#/$defs/cost" }
      }
    },
    "roundPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finder", "candidateEvaluator", "modeActivity", "patchPlanner", "maxDynamicNodes"],
      "properties": {
        "finder": { "$ref": "#/$defs/activityReservation" },
        "candidateEvaluator": { "$ref": "#/$defs/activityReservation" },
        "modeActivity": {
          "oneOf": [{ "$ref": "#/$defs/activityReservation" }, { "type": "null" }]
        },
        "patchPlanner": {
          "oneOf": [{ "$ref": "#/$defs/activityReservation" }, { "type": "null" }]
        },
        "maxDynamicNodes": { "$ref": "#/$defs/counter" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "costUsd"],
      "properties": {
        "attempts": { "$ref": "#/$defs/counter" },
        "costUsd": { "$ref": "#/$defs/cost" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "code", "retryable", "inDoubt"],
      "properties": {
        "phase": { "$ref": "#/$defs/activityPhase" },
        "code": {
          "type": "string",
          "pattern": "^GE_[A-Z0-9_]{3,64}$"
        },
        "retryable": { "type": "boolean" },
        "inDoubt": { "type": "boolean" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 512 },
        "value": {}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "verdict"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 512 },
        "verdict": { "enum": ["accept", "reject", "unknown"] }
      }
    },
    "modeOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "until-dry" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "condition"],
          "properties": {
            "mode": { "const": "while" },
            "condition": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "verdict"],
          "properties": {
            "mode": { "const": "evaluator-optimizer" },
            "verdict": { "enum": ["accept", "revise", "unknown"] }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "path"],
      "properties": {
        "code": { "type": "string", "pattern": "^GE_[A-Z0-9_]{3,64}$" },
        "phase": { "type": "integer", "minimum": 1, "maximum": 13 },
        "path": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" }
      }
    },
    "authoritySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposerActivityKey",
        "principalHash",
        "proposerGrantHash",
        "runGrantHash",
        "tenantGrantHash",
        "deploymentGrantHash",
        "effectiveGrantHash",
        "policyHash",
        "approvalHash"
      ],
      "properties": {
        "proposerActivityKey": { "$ref": "#/$defs/hash" },
        "principalHash": { "$ref": "#/$defs/hash" },
        "proposerGrantHash": { "$ref": "#/$defs/hash" },
        "runGrantHash": { "$ref": "#/$defs/hash" },
        "tenantGrantHash": { "$ref": "#/$defs/hash" },
        "deploymentGrantHash": { "$ref": "#/$defs/hash" },
        "effectiveGrantHash": { "$ref": "#/$defs/hash" },
        "policyHash": { "$ref": "#/$defs/hash" },
        "approvalHash": {
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        }
      }
    },
    "patchBudgetOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservationId", "requested", "committed", "released"],
      "properties": {
        "reservationId": { "$ref": "#/$defs/identifier" },
        "requested": { "$ref": "#/$defs/budgetDelta" },
        "committed": { "$ref": "#/$defs/budgetDelta" },
        "released": { "$ref": "#/$defs/budgetDelta" }
      }
    },
    "patchDecisionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "plannerActivityKey",
        "patchId",
        "patch",
        "patchHash",
        "requestedBase",
        "authoritySnapshot",
        "policySnapshotHash",
        "budgetOutcome",
        "diagnostics",
        "decidedAtDurationMs"
      ],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "plannerActivityKey": { "$ref": "#/$defs/hash" },
        "patchId": { "$ref": "#/$defs/identifier" },
        "patch": { "$ref": "#/$defs/patchPayload" },
        "patchHash": { "$ref": "#/$defs/hash" },
        "requestedBase": { "$ref": "#/$defs/graphCoordinate" },
        "authoritySnapshot": { "$ref": "#/$defs/authoritySnapshot" },
        "policySnapshotHash": { "$ref": "#/$defs/hash" },
        "budgetOutcome": { "$ref": "#/$defs/patchBudgetOutcome" },
        "diagnostics": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "decidedAtDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "outcome": { "enum": ["accepted", "rejected"] },
        "resultingRevision": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph-revision.schema.json"
        },
        "errorCode": { "type": "string", "pattern": "^GE_PATCH_[A-Z0-9_]{3,64}$" }
      }
    },
    "patchDecisionProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["patchId", "patchHash", "outcome", "requestedBase", "resultingRevision"],
          "properties": {
            "patchId": { "$ref": "#/$defs/identifier" },
            "patchHash": { "$ref": "#/$defs/hash" },
            "outcome": { "const": "accepted" },
            "requestedBase": { "$ref": "#/$defs/graphCoordinate" },
            "resultingRevision": { "$ref": "#/$defs/graphCoordinate" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["patchId", "patchHash", "outcome", "requestedBase", "errorCode"],
          "properties": {
            "patchId": { "$ref": "#/$defs/identifier" },
            "patchHash": { "$ref": "#/$defs/hash" },
            "outcome": { "const": "rejected" },
            "requestedBase": { "$ref": "#/$defs/graphCoordinate" },
            "errorCode": { "type": "string", "pattern": "^GE_PATCH_[A-Z0-9_]{3,64}$" }
          }
        }
      ]
    },
    "roundRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "candidateBatchHash",
        "candidateCount",
        "freshKeys",
        "duplicateKeys",
        "acceptedKeys",
        "rejectedKeys",
        "unknownKeys",
        "modeOutcome",
        "patchDecision",
        "consecutiveDryRounds",
        "attemptsUsed",
        "costUsd",
        "dynamicNodes",
        "durationMs",
        "currentRevision"
      ],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "candidateBatchHash": { "$ref": "#/$defs/hash" },
        "candidateCount": { "$ref": "#/$defs/counter" },
        "freshKeys": { "$ref": "#/$defs/keyArray" },
        "duplicateKeys": { "$ref": "#/$defs/keyArray" },
        "acceptedKeys": { "$ref": "#/$defs/keyArray" },
        "rejectedKeys": { "$ref": "#/$defs/keyArray" },
        "unknownKeys": { "$ref": "#/$defs/keyArray" },
        "modeOutcome": { "$ref": "#/$defs/modeOutcome" },
        "patchDecision": {
          "oneOf": [{ "$ref": "#/$defs/patchDecisionProjection" }, { "type": "null" }]
        },
        "consecutiveDryRounds": { "$ref": "#/$defs/counter" },
        "attemptsUsed": { "$ref": "#/$defs/counter" },
        "costUsd": { "$ref": "#/$defs/cost" },
        "dynamicNodes": { "$ref": "#/$defs/counter" },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "currentRevision": { "$ref": "#/$defs/graphCoordinate" }
      }
    },
    "keyArray": {
      "type": "array",
      "maxItems": 100000,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "controllerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "objectiveHash",
        "keyStrategyId",
        "rubricIdentity",
        "authorityCeilingHash",
        "pricingPolicyHash",
        "initialGraphRevision",
        "initialGraphHash",
        "initialRevisionHash"
      ],
      "properties": {
        "policy": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-policy.schema.json"
        },
        "objectiveHash": { "$ref": "#/$defs/hash" },
        "keyStrategyId": { "$ref": "#/$defs/versionedIdentity" },
        "rubricIdentity": { "$ref": "#/$defs/versionedIdentity" },
        "authorityCeilingHash": { "$ref": "#/$defs/hash" },
        "pricingPolicyHash": { "$ref": "#/$defs/hash" },
        "initialGraphRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "initialGraphHash": { "$ref": "#/$defs/hash" },
        "initialRevisionHash": { "$ref": "#/$defs/hash" }
      }
    },
    "controllerCreatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "requestHash", "identity", "controllerHash", "startedAt", "deadlineAt"],
      "properties": {
        "request": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller.schema.json"
        },
        "requestHash": { "$ref": "#/$defs/hash" },
        "identity": { "$ref": "#/$defs/controllerIdentity" },
        "controllerHash": { "$ref": "#/$defs/hash" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "deadlineAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "leaseAcquiredData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "previousLeaseId"],
      "properties": {
        "reason": { "enum": ["start", "resume", "takeover"] },
        "previousLeaseId": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        }
      }
    },
    "leaseRenewedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousExpiresAt", "newExpiresAt"],
      "properties": {
        "previousExpiresAt": { "$ref": "#/$defs/timestamp" },
        "newExpiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "leaseReleasedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "enum": ["paused", "handoff"] }
      }
    },
    "roundReservedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "plan", "planHash", "reservationId", "maximum", "deadlineAt", "currentRevision"],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "plan": { "$ref": "#/$defs/roundPlan" },
        "planHash": { "$ref": "#/$defs/hash" },
        "reservationId": { "$ref": "#/$defs/identifier" },
        "maximum": { "$ref": "#/$defs/budgetDelta" },
        "deadlineAt": { "$ref": "#/$defs/timestamp" },
        "currentRevision": { "$ref": "#/$defs/graphCoordinate" }
      }
    },
    "activityStartedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "phase",
        "activityId",
        "activityKey",
        "attempt",
        "sideEffects",
        "inputHash",
        "reservationId"
      ],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "phase": { "$ref": "#/$defs/activityPhase" },
        "activityId": { "$ref": "#/$defs/identifier" },
        "activityKey": { "$ref": "#/$defs/hash" },
        "attempt": { "$ref": "#/$defs/positiveCounter" },
        "sideEffects": { "enum": ["none", "idempotent", "non-idempotent"] },
        "inputHash": { "$ref": "#/$defs/hash" },
        "reservationId": { "$ref": "#/$defs/identifier" }
      }
    },
    "activityFailedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "activityKey", "attempt", "failure", "usage"],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "activityKey": { "$ref": "#/$defs/hash" },
        "attempt": { "$ref": "#/$defs/positiveCounter" },
        "failure": { "$ref": "#/$defs/failure" },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "discoveryCommittedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "activityKey",
        "candidateBatch",
        "candidateBatchHash",
        "candidateCount",
        "freshKeys",
        "duplicateKeys",
        "seenAdditions",
        "usage",
        "durationMs"
      ],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "activityKey": { "$ref": "#/$defs/hash" },
        "candidateBatch": { "$ref": "#/$defs/inlinePayload" },
        "candidateBatchHash": { "$ref": "#/$defs/hash" },
        "candidateCount": { "$ref": "#/$defs/counter" },
        "freshKeys": { "$ref": "#/$defs/keyArray" },
        "duplicateKeys": { "$ref": "#/$defs/keyArray" },
        "seenAdditions": { "$ref": "#/$defs/keyArray" },
        "usage": { "$ref": "#/$defs/usage" },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "candidateEvaluationCommittedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "activityKey",
        "verdicts",
        "acceptedKeys",
        "rejectedKeys",
        "unknownKeys",
        "usage",
        "durationMs"
      ],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "activityKey": { "$ref": "#/$defs/hash" },
        "verdicts": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/verdict" }
        },
        "acceptedKeys": { "$ref": "#/$defs/keyArray" },
        "rejectedKeys": { "$ref": "#/$defs/keyArray" },
        "unknownKeys": { "$ref": "#/$defs/keyArray" },
        "usage": { "$ref": "#/$defs/usage" },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "modeOutcomeCommittedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "activityKey", "outcome", "usage", "durationMs"],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "activityKey": {
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "outcome": { "$ref": "#/$defs/modeOutcome" },
        "usage": { "$ref": "#/$defs/usage" },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "budgetReservationSettledData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "reservationId", "phase", "committed", "totals"],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "reservationId": { "$ref": "#/$defs/identifier" },
        "phase": { "$ref": "#/$defs/activityPhase" },
        "committed": { "$ref": "#/$defs/budgetDelta" },
        "totals": { "$ref": "#/$defs/budgetTotals" }
      }
    },
    "budgetReservationReleasedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "reservationId", "reason", "released", "remaining", "totals"],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "reservationId": { "$ref": "#/$defs/identifier" },
        "reason": { "enum": ["phase-complete", "round-complete", "failed", "cancelled", "patch-rejected", "bound-reached"] },
        "phase": { "$ref": "#/$defs/activityPhase" },
        "released": { "$ref": "#/$defs/budgetDelta" },
        "remaining": { "$ref": "#/$defs/budgetDelta" },
        "totals": { "$ref": "#/$defs/budgetTotals" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reason": { "const": "phase-complete" } },
            "required": ["reason"]
          },
          "then": {
            "properties": { "phase": { "$ref": "#/$defs/activityPhase" } },
            "required": ["phase"]
          },
          "else": { "properties": { "phase": false } }
        }
      ]
    },
    "patchAcceptedData": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/patchDecisionBase" },
        {
          "type": "object",
          "required": ["outcome", "resultingRevision"],
          "properties": {
            "outcome": { "const": "accepted" },
            "resultingRevision": {
              "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph-revision.schema.json"
            },
            "diagnostics": { "type": "array", "maxItems": 0 },
            "errorCode": false
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "patchRejectedData": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/patchDecisionBase" },
        {
          "type": "object",
          "required": ["outcome", "errorCode"],
          "properties": {
            "outcome": { "const": "rejected" },
            "errorCode": { "type": "string", "pattern": "^GE_PATCH_[A-Z0-9_]{3,64}$" },
            "diagnostics": { "type": "array", "minItems": 1 },
            "resultingRevision": false
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "roundCommittedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record"],
      "properties": { "record": { "$ref": "#/$defs/roundRecord" } }
    },
    "exitObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelled",
        "maxDuration",
        "maxCost",
        "maxTotalAttempts",
        "maxDynamicNodes",
        "maxDiscoveries",
        "maxIterations",
        "patchRejected",
        "failed",
        "failureCode",
        "unknownVerdict",
        "convergenceReason"
      ],
      "properties": {
        "cancelled": { "type": "boolean" },
        "maxDuration": { "type": "boolean" },
        "maxCost": { "type": "boolean" },
        "maxTotalAttempts": { "type": "boolean" },
        "maxDynamicNodes": { "type": "boolean" },
        "maxDiscoveries": { "type": "boolean" },
        "maxIterations": { "type": "boolean" },
        "patchRejected": { "type": "boolean" },
        "failed": { "type": "boolean" },
        "failureCode": {
          "oneOf": [
            { "type": "string", "pattern": "^GE_[A-Z0-9_]{3,64}$" },
            { "type": "null" }
          ]
        },
        "unknownVerdict": { "type": "boolean" },
        "convergenceReason": {
          "oneOf": [
            { "enum": ["DRY", "CONDITION_FALSE", "EVALUATOR_ACCEPTED"] },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "failed": { "const": true } },
            "required": ["failed"]
          },
          "then": {
            "properties": {
              "failureCode": { "type": "string", "pattern": "^GE_[A-Z0-9_]{3,64}$" }
            }
          },
          "else": {
            "properties": { "failureCode": { "type": "null" } }
          }
        }
      ]
    },
    "controllerTerminatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "result"],
      "properties": {
        "observation": { "$ref": "#/$defs/exitObservation" },
        "result": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-result.schema.json"
        }
      }
    }
  }
}
