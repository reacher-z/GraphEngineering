  "invalidPolicyCases": [
    {"name": "missing-max-iterations", "remove": "#/maxIterations", "expectCode": "GE_CYCLE_INVALID_POLICY"},
    {"name": "zero-max-iterations", "replace": {"path": "#/maxIterations", "value": 0}, "expectCode": "GE_CYCLE_INVALID_POLICY"},
    {"name": "max-iterations-over-protocol-ceiling", "replace": {"path": "#/maxIterations", "value": 10001}, "expectCode": "GE_CYCLE_INVALID_POLICY"},
    {"name": "discoveries-over-protocol-ceiling", "replace": {"path": "#/maxDiscoveries", "value": 10000001}, "expectCode": "GE_CYCLE_INVALID_POLICY"},
