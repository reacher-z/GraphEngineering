  "recoveryCases": [
    {
      "name": "seen-addition-survives-crash-before-evaluation",
      "durablePrefix": [
        {"phase": "reserved", "iteration": 1},
        {"phase": "discovered", "iteration": 1, "candidates": [{"key": "a", "value": 1}], "seenAdditions": ["a"]}
      ],
      "resume": {"verdicts": [{"key": "a", "verdict": "reject"}], "followingCandidateKeys": [["a"], ["a"]]},
      "expect": {"exitReason": "DRY", "iterations": 3, "seenCount": 1, "rejectedCount": 1, "finderCallsForIterationOneAfterResume": 0}
    },
    {
      "name": "crash-before-discovery-commit-does-not-partially-insert",
      "durablePrefix": [{"phase": "reserved", "iteration": 1}],
      "openFinder": {"sideEffects": "none", "activityKey": "same-key-on-resume"},
      "expect": {"seenCountBeforeResume": 0, "resumeSameIteration": 1, "newIterationReservations": 0}
    },
    {
      "name": "terminal-replay-does-not-reexecute-or-redecide",
      "durablePrefix": [{"phase": "terminal", "exitReason": "MAX_COST"}],
      "expect": {"exitReason": "MAX_COST", "finderCalls": 0, "evaluatorCalls": 0, "clockCalls": 0, "patchApplications": 0}
    },
    {
      "name": "fork-after-discovery-inherits-prefix-seen-only",
