        "rollbackSemanticOperation":{"const":"native-driver-rollback-on-exact-owned-connection"},
        "activeOwnerRawTransactionControl":{"const":"forbidden"},
        "failureCleanupWithoutAuthenticatedPrimary":{"const":"forbidden"},
        "callerCallbackOrThunk":{"const":"forbidden"},"callerSuppliedOutcome":{"const":"forbidden"},
        "futureTargetCasesAreRuntimeEvidence":{"const":false},"runtimeExecutedCaseCount":{"const":0},
        "contractRuntimeTransactionControlCount":{"const":0},
        "guardedTransactionControlPaths":{"type":"array","minItems":19,"maxItems":19,"uniqueItems":true,"items":{"type":"string"}}
      }
    },
    "beginContract": {
      "type":"object","additionalProperties":false,
