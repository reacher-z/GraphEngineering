{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/conformance/sqlite-cursor-publication-transaction-owner-v1.schema.json",
  "title": "SQLite cursor publication transaction owner contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","status","claims","anchors","boundary","beginContract","identityContract","dependencyContract","arbiterContract","registryContract","lifecycleContract","commitAmbiguityContract","reopenClassificationContract","failurePrecedenceContract","futureCaseCounterContract","beginPostflightFutureTargets","cleanupFaultFutureTargets","reopenOutcomeFutureTargets","futureTargetCases","nonclaims","fixtureDigestContract","fixtureCanonicalSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"const": "sqlite-cursor-publication-transaction-owner-v1"},
    "status": {"const": "contract-frozen-redbar"},
    "claims": {"$ref": "#/$defs/claims"},
    "anchors": {"$ref": "#/$defs/anchors"},
    "boundary": {"$ref": "#/$defs/boundary"},
    "beginContract": {"$ref": "#/$defs/beginContract"},
    "identityContract": {"$ref": "#/$defs/identityContract"},
    "dependencyContract": {"$ref": "#/$defs/dependencyContract"},
    "arbiterContract": {"$ref": "#/$defs/arbiterContract"},
    "registryContract": {"$ref": "#/$defs/registryContract"},
    "lifecycleContract": {"$ref": "#/$defs/lifecycleContract"},
    "commitAmbiguityContract": {"$ref": "#/$defs/commitAmbiguityContract"},
    "reopenClassificationContract": {"$ref": "#/$defs/reopenClassificationContract"},
    "failurePrecedenceContract": {"$ref": "#/$defs/failurePrecedenceContract"},
    "futureCaseCounterContract": {"$ref": "#/$defs/futureCaseCounterContract"},
    "beginPostflightFutureTargets": {"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/beginPostflightFutureTarget"}},
    "cleanupFaultFutureTargets": {"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/cleanupFaultFutureTarget"}},
    "reopenOutcomeFutureTargets": {"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/reopenOutcomeFutureTarget"}},
    "futureTargetCases": {"type":"array","minItems":13,"maxItems":13,"items":{"$ref":"#/$defs/futureCase"}},
    "nonclaims": {"type":"array","minItems":15,"maxItems":15,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "fixtureDigestContract": {"$ref": "#/$defs/fixtureDigestContract"},
    "fixtureCanonicalSha256": {"type":"string","pattern":"^[0-9a-f]{64}$"}
