      "properties": {
        "commonExactObjects":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"type":"string"}},
        "failurePresentationObjects":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"type":"string"}},
        "successCommitPresentationObjects":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"type":"string"}},
        "commitFailureCleanupPresentationObjects":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"type":"string"}},
        "finalFenceTransitivelyAuthenticates":{"type":"array","minItems":13,"maxItems":13,"uniqueItems":true,"items":{"type":"string"}},
        "successOwnerDirectStrongPresentation":{"const":"exact-final-commit-fence-only"},
        "cloneProxySubclassOrReconstructionRejected":{"const":true},
        "crossConnectionLineageGenerationAuthorityOrRunRejected":{"const":true},
        "ownerAndFenceReplayRejected":{"const":true},"integerIdIsBucketOnlyNeverAuthority":{"const":true}
      }
    },
    "dependencyContract": {
      "type":"object","additionalProperties":false,
      "required":["atomicPublicationOrder","directCommitAuthoritiesRejected","validationBeforeFenceConsumption","fenceConsumptionBeforeCommitIo","successSelectionMintsNewCapability","permanentWriteAfterPreRetirementForbidden","ownedTempResidueAtCommit"],
      "properties": {
        "atomicPublicationOrder":{"type":"array","minItems":30,"maxItems":30,"uniqueItems":true,"items":{"type":"string"}},
        "directCommitAuthoritiesRejected":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string"}},
        "validationBeforeFenceConsumption":{"const":true},"fenceConsumptionBeforeCommitIo":{"const":true},
        "successSelectionMintsNewCapability":{"const":false},"permanentWriteAfterPreRetirementForbidden":{"const":true},
        "ownedTempResidueAtCommit":{"const":0}
      }
    },
    "arbiterContract": {
      "type":"object","additionalProperties":false,
      "required":["registrationKey","postBeginBinding","postOuterBinding","bindingDirection","claimStateOrder","atMostOneLiveOutcomeClaim","failureClaimBlocksSuccess","successClaimBlocksPostConsumeFailureOwner","commitFailureCleanupIsInternalToSuccessClaim","successAuthorityTombstoneBeforeCommitFailureCleanup","connectionTerminalGuardRequired","contextVarSuccessAuthorityForbidden"],
      "properties": {
        "registrationKey":{"const":"exact-connection-plus-transaction-owner"},
        "postBeginBinding":{"const":"exact-begin-receipt-plus-lineage-plus-generation"},
        "postOuterBinding":{"const":"exact-outer-publication-authority"},
        "bindingDirection":{"const":"one-way-monotonic"},
        "claimStateOrder":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"const":"unclaimed"},{"const":"failure-claimed-or-success-claimed"}],"items":false},
        "atMostOneLiveOutcomeClaim":{"const":true},"failureClaimBlocksSuccess":{"const":true},
        "successClaimBlocksPostConsumeFailureOwner":{"const":true},"commitFailureCleanupIsInternalToSuccessClaim":{"const":true},
        "successAuthorityTombstoneBeforeCommitFailureCleanup":{"const":true},"connectionTerminalGuardRequired":{"const":true},
        "contextVarSuccessAuthorityForbidden":{"const":true}
      }
    },
    "registryContract": {
      "type":"object","additionalProperties":false,
      "required":["successAuthorityTransport","ownerRegistryKey","reverseEntry","connectionIdentityBearer","generationIdentityBearer","integerIdUse","authentication","partialRegistrationResidue","staleWeakrefCallbackMustMatchExactStoredEntry","abandonedOwnerGraphCollectible","terminalStrongGraphReferences","terminalSnapshotPureValuesNoPathExceptionOrAddress","ambientOrCopiedContextAuthority"],
      "properties": {
        "successAuthorityTransport":{"const":"explicit-final-fence-parameter-only"},
        "ownerRegistryKey":{"const":"exact-live-owner-object"},
        "reverseEntry":{"const":"exact-live-weak-connection-lineage-generation-authority-and-owner"},
        "connectionIdentityBearer":{"const":"exact-weakref-capable-owner-wrapper-not-raw-driver-handle"},
        "generationIdentityBearer":{"const":"exact-weakref-capable-opaque-provisional-generation-promoted-on-success"},
        "integerIdUse":{"const":"bucket-selection-only"},"authentication":{"const":"exact-live-object-identity-only"},
        "partialRegistrationResidue":{"const":0},"staleWeakrefCallbackMustMatchExactStoredEntry":{"const":true},
        "abandonedOwnerGraphCollectible":{"const":true},"terminalStrongGraphReferences":{"const":0},
        "terminalSnapshotPureValuesNoPathExceptionOrAddress":{"const":true},
        "ambientOrCopiedContextAuthority":{"const":"forbidden"}
