      "properties": {
        "registrationBeforeBeginIo":{"const":true},"requiresOpenAutocommitUnguardedConnection":{"const":true},
        "authority":{"const":"exact-one-shot-transaction-owner"},
        "nativeObservationSource":{"const":"definition-time-captured-connection-owner-intrinsic"},
        "callerOutcomeInputForbidden":{"const":true},"attemptMaximum":{"const":1},"retryForbidden":{"const":true},
        "provisionalGenerationMintedBeforeBeginIo":{"const":true},
        "provisionalGenerationBinding":{"const":"exact-owner-plus-exact-connection-plus-single-begin-attempt-nonce"},
        "provisionalGenerationPromotion":{"const":"only-after-returned-postflight-proves-exact-exclusive-transaction-active"},
        "provisionalGenerationTombstone":{"const":"before-any-failed-postflight-or-throw-cleanup"},
        "beginReceiptBeforePromotionForbidden":{"const":true},
        "returnedNextState":{"const":"active"},
        "returnedPostflightMismatchState":{"const":"begin-postflight-in-doubt"},
        "returnedAutocommitCleanup":{"const":"stable-postflight-primary-no-rollback-close-once-reopen-source-v1"},
        "returnedDifferentGenerationCleanup":{"const":"stable-postflight-primary-no-rollback-close-once-reopen-or-corrupt"},
        "returnedObservationUnavailableCleanup":{"const":"stable-postflight-primary-no-rollback-close-once-reopen-or-unresolved"},
        "throwSameGenerationActiveCleanup":{"const":"tombstone-begin-authority-then-rollback-once-close-once-reopen-source-v1"},
        "throwAutocommitCleanup":{"const":"no-rollback-close-once-reopen-source-v1"},
        "throwObservationUnavailableCleanup":{"const":"no-rollback-close-once-reopen-or-unresolved"},
        "beginPrimaryPrecedesCleanupDiagnostics":{"const":true},
        "receiptCommitments":{"type":"array","minItems":9,"maxItems":9,"uniqueItems":true,"items":{"type":"string"}}
      }
    },
    "identityContract": {
