    "lifecycleContract": {
      "type":"object","additionalProperties":false,
      "required":["states","allowedTransitions","beginCommitRollbackCloseRetryForbidden","attemptMaximumPerOperation","rollbackFailureStillAttemptsCloseOnce","rollbackThrowNeverClaimsRolledBack","terminalStrongPresentationCleared"],
      "properties": {
        "states":{"type":"array","minItems":25,"maxItems":25,"uniqueItems":true,"items":{"type":"string"}},
        "allowedTransitions":{"type":"array","minItems":36,"maxItems":36,"uniqueItems":true,"items":{"type":"string"}},
        "beginCommitRollbackCloseRetryForbidden":{"const":true},"attemptMaximumPerOperation":{"const":1},
        "rollbackFailureStillAttemptsCloseOnce":{"const":true},"rollbackThrowNeverClaimsRolledBack":{"const":true},
        "terminalStrongPresentationCleared":{"const":true}
      }
