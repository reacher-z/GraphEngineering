      "type":"object","additionalProperties":false,
      "required":["implementationClaim","protocolClaim","releaseGate","runtimeTransactionControlClaim","driverNativeBeginThrowClaim","driverNativeCommitThrowClaim","crashReopenClaim","publicApiClaim"],
      "properties": {
        "implementationClaim":{"const":false},"protocolClaim":{"const":false},"releaseGate":{"const":false},
        "runtimeTransactionControlClaim":{"const":false},"driverNativeBeginThrowClaim":{"const":false},
        "driverNativeCommitThrowClaim":{"const":false},"crashReopenClaim":{"const":false},"publicApiClaim":{"const":false}
      }
    },
    "anchors": {
      "type":"object","additionalProperties":false,
      "required":["rebindContractId","rebindFixtureCanonicalSha256","failureFinalizerContractId","failureFinalizerFixtureCanonicalSha256"],
      "properties": {
        "rebindContractId":{"const":"sqlite-cursor-publication-rebind-v2"},
        "rebindFixtureCanonicalSha256":{"const":"d368cd53e819e06e950f2dabedcb5a5b2fca535536efe85abb2e4b488bae2e7d"},
        "failureFinalizerContractId":{"const":"sqlite-post-consume-transaction-failure-finalizer-v1"},
        "failureFinalizerFixtureCanonicalSha256":{"const":"81c055216223c89dc68055bbf325a73c61bfb899977dfb6255059137783ae360"}
      }
    },
    "boundary": {
      "type":"object","additionalProperties":false,
      "required":["stableTaskId","role","beginSql","commitSemanticOperation","rollbackSemanticOperation","activeOwnerRawTransactionControl","failureCleanupWithoutAuthenticatedPrimary","callerCallbackOrThunk","callerSuppliedOutcome","futureTargetCasesAreRuntimeEvidence","runtimeExecutedCaseCount","contractRuntimeTransactionControlCount","guardedTransactionControlPaths"],
