{
  "apiVersion": "graphengineering.reacher-z.github.io/authoring-conformance/v1alpha1",
  "kind": "AuthoringCases",
  "identityGolden": "component-identity.expected.json",
  "equivalenceCases": [
    {
      "name": "equivalent-diamond",
      "json": "equivalent.graph.json",
      "yaml": "equivalent.graph.yaml",
      "builderGraph": "equivalent.graph.json",
      "identityKey": "equivalent",
      "expect": {
        "graphHash": "e0a73c69d3891b35fbb775514b0dbc9b246e237af2af3d426124c9330b7333d2",
        "topologicalLayers": [["split"], ["left", "right"], ["merge"]]
      }
    },
    {
      "name": "typed-port-diamond",
      "json": "typed-ports.graph.json",
      "yaml": "typed-ports.graph.yaml",
      "builderGraph": "typed-ports.graph.json",
      "identityKey": "typed-ports",
      "expect": {
        "graphHash": "56e8a96ae2229faaa1732182f08df8782cedebda9f6770b54d336752522329e0",
        "topologicalLayers": [["split"], ["left", "right"], ["merge"]]
      }
    }
  ],
  "validSourceCases": [
    {
      "name": "declaration-order",
      "yaml": "declaration-order.graph.yaml",
      "expect": {
        "graphHash": "cf66493e26334db367adc33a64b19a6774fcf42eb6d76100856dc317f4b3ff5e",
        "revisionHash": "accacf45d2b9fd4257bdd4ae94d5b2eb673c5f12b9fb4353d4e5519617ef8810",
        "nodeOrder": ["zeta", "alpha", "merge"],
        "edgeOrder": ["zeta-merge", "alpha-merge"],
        "topologicalLayers": [["zeta", "alpha"], ["merge"]]
      }
    },
    {
      "name": "yaml-1.2-scalars",
      "yaml": "yaml-scalars.graph.yaml",
      "expect": {
        "graphHash": "38da2d912d44ffde0b6fb8e82ce9b824f4986fd5ca940e4703174ec5d63a05e2",
