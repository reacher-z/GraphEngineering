        "revisionHash": "a58f675edb879a2755de1b300dfc3647da5f605a8df881268bcde8dc7fe6ae07",
        "nodeConfig": null,
        "policyExtensionValue": null
      }
    },
    {
      "name": "safe-integer-and-timer-ceilings",
      "yaml": "safe-integer-edges.graph.yaml",
      "expect": {
        "graphHash": "e11c2920f41b0fd7f0fc84863fc85d3f4f5ae9f4aeff0f9c19b2442c375c7e4f",
        "revisionHash": "1ec4f9607056543b17ae8f702cb3635b219bad7214c58fed66181cb9dfd3fc7a"
      }
    },
    {
      "name": "unicode-and-reserved-output-keys",
      "json": "unicode-and-keys.graph.json",
