  "semanticCases": [
    {
      "name": "stale-base-is-not-rebased",
      "baseGraph": "diamond.graph.json",
      "mutation": "replace base.graphRevision with the prior revision",
      "expectCode": "GE_PATCH_STALE_BASE"
    },
    {
      "name": "existing-node-id-cannot-be-shadowed",
      "baseGraph": "diamond.graph.json",
      "mutation": "append a node whose id is split",
      "expectCode": "GE_PATCH_DUPLICATE_ID"
    },
    {
      "name": "back-edge-remains-an-ordinary-cycle",
      "baseGraph": "diamond.graph.json",
      "mutation": "append an edge from merge to split",
      "expectCode": "GE_PATCH_GRAPH_INVALID"
    },
    {
      "name": "capability-expansion-fails-closed",
      "baseGraph": "diamond.graph.json",
      "mutation": "append a node requesting an unavailable network capability",
      "expectCode": "GE_PATCH_AUTHORITY_EXPANSION"
    },
    {
      "name": "incoming-edge-to-existing-pending-node-is-forbidden",
      "baseGraph": "diamond.graph.json",
      "mutation": "append an edge targeting the existing pending node merge",
      "expectCode": "GE_PATCH_STATE_CONFLICT"
    },
    {
      "name": "unsupported-stream-edge-fails-before-scheduling",
      "baseGraph": "diamond.graph.json",
      "mutation": "append a stream edge when stream execution is unavailable",
      "expectCode": "GE_PATCH_UNSUPPORTED"
    },
    {
      "name": "exact-accepted-retry-precedes-stale-base",
      "operation": "apply one accepted patch, advance the current revision, then retry its exact canonical bytes",
      "expectOutcome": "return-recorded-acceptance",
      "expectSchedulerMutations": 0
    },
    {
      "name": "exact-rejected-retry-is-idempotent",
      "operation": "retry exact canonical bytes for a durably rejected patchId after policy changes",
      "expectOutcome": "return-recorded-rejection",
      "expectSchedulerMutations": 0
    },
    {
      "name": "decided-id-with-different-bytes-conflicts",
      "operation": "reuse a decided patchId with one changed append value",
      "expectCode": "GE_PATCH_IDEMPOTENCY_CONFLICT"
    },
    {
      "name": "stale-base-race-has-one-winner",
      "operation": "concurrently apply two distinct patchIds against the same current base",
      "expectAccepted": 1,
      "expectRejectedCode": "GE_PATCH_STALE_BASE"
    },
    {
      "name": "dry-run-does-not-reserve-id-budget-or-cache-authority",
      "operation": "dry-run, change authority and budget, then perform a real apply",
      "expectRealApply": "repeat-all-gates",
      "expectDryRunMutations": 0
    },
    {
      "name": "patch-over-canonical-byte-ceiling-fails-before-compiler",
      "operation": "supply a patch whose canonical UTF-8 exceeds 4194304 bytes",
      "expectCode": "GE_PATCH_INVALID",
      "expectCompilerCalls": 0
    },
    {
      "name": "patch-over-portable-depth-fails-before-compiler",
      "operation": "supply config nested beyond 100 constructed levels",
      "expectCode": "GE_PATCH_INVALID",
      "expectCompilerCalls": 0
    }
  ]
}
