{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/conformance/sqlite-baseline-reconciliation.schema.json",
  "title": "SQLite v1 baseline reconciliation registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "status", "implementationClaim", "releaseGate",
    "productionThroughputClaim", "entryKinds",
    "diagnosticEnvelope", "tempStorage", "cursorSeal", "rules"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sqlite-baseline-reconciliation-v1" },
    "status": { "const": "registry-frozen" },
    "implementationClaim": { "const": false },
    "releaseGate": { "const": false },
    "productionThroughputClaim": { "const": false },
    "entryKinds": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "schema-envelope" },
        { "const": "migration-lineage" },
        { "const": "stream-head" },
        { "const": "record-identity" },
        { "const": "checkpoint-current" },
        { "const": "checkpoint-revision" },
        { "const": "lease-current" },
        { "const": "used-lease-identity" },
        { "const": "legal-hold" },
        { "const": "migration-lock-current" },
        { "const": "used-migration-lock-identity" },
        { "const": "legacy-operation" }
      ],
      "items": false
    },
    "diagnosticEnvelope": { "$ref": "#/$defs/diagnosticEnvelope" },
    "tempStorage": { "$ref": "#/$defs/tempStorage" },
    "cursorSeal": { "$ref": "#/$defs/cursorSeal" },
    "rules": {
      "type": "array",
      "minItems": 53,
      "maxItems": 53,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "diagnosticEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "defaultDiagnosticLimit", "maximumDiagnosticLimit", "tenantControlledValuesAllowed"],
      "properties": {
        "fields": {
          "type": "array",
          "prefixItems": [
            { "const": "ruleId" },
            { "const": "violationCount" },
            { "const": "diagnosticsTruncated" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "defaultDiagnosticLimit": { "const": 16 },
        "maximumDiagnosticLimit": { "const": 64 },
        "tenantControlledValuesAllowed": { "const": false }
      }
    },
    "tempStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempStore", "defaultCacheKiB", "minimumCacheKiB", "maximumCacheKiB", "cacheSpill", "tempStoreDirectoryAllowed"],
      "properties": {
        "tempStore": { "const": "FILE" },
        "defaultCacheKiB": { "const": 8192 },
        "minimumCacheKiB": { "const": 1024 },
        "maximumCacheKiB": { "const": 65536 },
        "cacheSpill": { "const": true },
        "tempStoreDirectoryAllowed": { "const": false }
      }
    },
    "cursorSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolClaim", "emptyRootStatus", "rowDomain", "chainDomain", "sort", "mutableRebindFields", "immutableBlobDigests", "immutableScalarFields"],
      "properties": {
        "protocolClaim": { "const": false },
        "emptyRootStatus": { "const": "deferred-cross-language-derivation" },
        "rowDomain": { "const": "graph-engineering/sqlite-cursor-seal-row/v1\u0000" },
        "chainDomain": { "const": "graph-engineering/sqlite-cursor-seal/v1\u0000" },
        "sort": {
          "type": "array",
          "prefixItems": [
            { "const": "token-hash-utf8-bytes" },
            { "const": "tenant-id-utf8-bytes" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "mutableRebindFields": {
          "type": "array",
          "prefixItems": [
            { "const": "providerDescriptorHash" },
            { "const": "schemaIdentitySha256" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "immutableBlobDigests": {
          "type": "array",
          "prefixItems": [
            { "const": "requestScopeBlobSha256" },
            { "const": "snapshotBlobSha256" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "immutableScalarFields": {
          "type": "array",
          "prefixItems": [
            { "const": "tenantId" },
            { "const": "tokenHash" },
            { "const": "kind" },
            { "const": "principalHash" },
            { "const": "authorizationHash" },
            { "const": "streamId" },
            { "const": "checkpointScope" },
            { "const": "requestScopeByteLength" },
            { "const": "pageSize" },
            { "const": "nextPosition" },
            { "const": "snapshotTailSequence" },
            { "const": "snapshotTailRecordHash" },
            { "const": "snapshotByteLength" },
            { "const": "createdAtMs" },
            { "const": "expiresAtMs" },
            { "const": "consumedAtMs" }
          ],
          "items": false,
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "violationCount", "diagnosticsTruncated"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^BLR_[A-Z0-9]+(?:_[A-Z0-9]+)*$" },
        "violationCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "diagnosticsTruncated": { "type": "boolean" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "phase"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^BLR_[A-Z0-9]+(?:_[A-Z0-9]+)*$" },
        "phase": {
          "enum": ["owner", "source", "stage", "stream-record", "checkpoint", "lease-lock-hold", "legacy", "cursor", "publication"]
        }
      }
    }
  }
}
