{
  "contractVersion": "subgraph-edge/v1alpha1",
  "description": "D4 contract-only vectors for nested scopes, deterministic reducers, artifact references, durable stream edges, and event/checkpoint lineage. Native execution is intentionally not implied.",
  "contractStatus": "contract-only-native-implementation-required",
  "implementationClaim": false,
  "sourceGraphs": {
    "root": {
      "apiVersion": "graphengineering.reacher-z.github.io/v1alpha1",
      "kind": "Graph",
      "metadata": {
        "name": "d4-root",
        "version": "1.0.0"
      },
      "inputSchema": {},
      "outputSchema": {},
      "entrypoints": ["seed"],
      "outputs": {
        "result": { "node": "sink" }
      },
      "nodes": [
        {
          "id": "seed",
          "kind": "transform",
          "inputSchema": {},
          "outputSchema": {},
          "config": null
        },
        {
          "id": "nested",
          "kind": "subgraph",
          "inputSchema": {},
          "outputSchema": {},
          "config": null
        },
        {
          "id": "artifactConsumer",
          "kind": "transform",
          "inputSchema": {},
          "outputSchema": {},
          "config": null
        },
        {
          "id": "streamConsumer",
          "kind": "transform",
          "inputSchema": {},
          "outputSchema": {},
          "config": null
        },
        {
          "id": "sink",
          "kind": "transform",
          "inputSchema": {},
          "outputSchema": {},
          "config": null
        }
      ],
      "edges": [
        {
          "id": "e_seed_nested",
          "from": { "node": "seed" },
          "to": { "node": "nested" },
          "mode": "value"
        },
        {
          "id": "e_nested_artifact",
          "from": { "node": "nested" },
          "to": { "node": "artifactConsumer", "port": "artifact" },
          "mode": "artifact-ref"
        },
        {
          "id": "e_nested_stream",
          "from": { "node": "nested" },
          "to": { "node": "streamConsumer", "port": "items" },
          "mode": "stream"
        },
        {
          "id": "e_artifact_sink",
          "from": { "node": "artifactConsumer" },
          "to": { "node": "sink", "port": "artifactResult" },
          "mode": "value"
        },
        {
          "id": "e_stream_sink",
          "from": { "node": "streamConsumer" },
          "to": { "node": "sink", "port": "streamResult" },
          "mode": "value"
        }
      ],
      "policies": {
        "maxConcurrency": 4,
        "maxTotalAttempts": 16,
        "maxDepth": 8,
        "maxFanOut": 4
      }
    },
    "child": {
      "apiVersion": "graphengineering.reacher-z.github.io/v1alpha1",
      "kind": "Graph",
      "metadata": {
        "name": "d4-child",
        "version": "1.0.0"
      },
      "inputSchema": {},
      "outputSchema": {},
      "stateSchema": {},
      "entrypoints": ["childStart"],
      "outputs": {
        "result": { "node": "reduce" }
