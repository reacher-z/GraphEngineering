  "planTemplate": {
    "apiVersion": "graphengineering.reacher-z.github.io/subgraph-edge-plans/v1alpha1",
    "kind": "SubgraphEdgePlan",
    "contractVersion": "subgraph-edge/v1alpha1",
    "planId": "d4-contract-plan",
    "activation": "requires-capability-negotiation",
    "namespaceCodec": "rfc6901-segments/v1alpha1",
    "rootGraphKey": "root",
    "requiredCapabilities": [
      "artifact-store/v1alpha1",
      "durable-stream-edge/v1alpha1",
      "nested-subgraph/v1alpha1",
      "state-reducer/v1alpha1",
      "subgraph-edge/v1alpha1",
      "trace-checkpoint-lineage/v1alpha1"
    ],
    "policies": {
      "maxNestingDepth": 4,
      "maxRecursiveDepth": 2,
      "maxTotalInvocations": 16,
      "maxConcurrentInvocations": 4,
      "maxStateBytes": 4096,
      "maxReducerWrites": 16,
      "maxArtifacts": 8,
      "maxArtifactBytes": 4096,
      "maxTotalArtifactBytes": 8192,
      "maxStreamEdges": 4,
      "maxStreamItemsPerEdge": 8,
      "maxTotalStreamItems": 16,
      "maxStreamInFlightBytes": 4096,
      "maxNamespaceBytes": 4096,
      "maxDurationMs": 60000,
      "unreducedStateWrites": "compile-error"
    },
    "authority": {
      "mode": "deny-by-default",
      "policyId": "d4-fixture-authority",
      "ceiling": [
        "artifact:delete",
        "artifact:read",
        "artifact:write",
        "stream:consume",
        "stream:produce"
      ]
    },
    "budget": {
      "mode": "hard-reservation-before-dispatch",
      "maxAttempts": 16,
      "maxDurationMs": 60000,
      "maxStateBytes": 4096,
      "maxArtifactBytes": 8192,
      "maxStreamItems": 16,
      "maxStreamInFlightBytes": 4096
    },
    "recovery": {
      "resume": "fold-authoritative-events-before-dispatch",
      "replay": "read-only-exact-prefix-no-dispatch",
      "fork": "new-run-new-scope-reauthorize",
      "successfulChildReuse": "exact-graph-plan-input-policy-and-committed-terminal-only"
    },
    "trace": {
      "contractVersion": "normalized-trace/v1alpha1",
      "capture": "metadata-only",
      "externalExport": "off-by-default",
      "clock": "recorded-wall-plus-run-monotonic-offset",
      "maxSpans": 128,
      "maxLinks": 256,
      "maxBytes": 1048576,
      "criticalPathInputs": "causal-links-state-and-wait-durations"
    },
    "graphsFromSources": ["child", "root"],
    "calls": [
      {
        "id": "call-child",
        "ownerGraphKey": "root",
        "nodeId": "nested",
        "childGraphKey": "child",
        "checkpointScope": "isolated",
        "maxCallsPerParent": 1,
        "inputProjection": { "mode": "whole" },
        "outputProjection": {
          "mode": "object",
          "fields": [
            {
              "sourceOutput": "result",
              "sourcePointer": "",
              "targetKey": "result",
              "required": true
            }
          ]
        },
        "recursion": { "mode": "forbid" },
        "authority": {
          "mode": "intersect-parent-ceiling",
          "requested": [
            "artifact:read",
            "artifact:write",
            "stream:consume",
            "stream:produce"
          ],
          "effective": [
            "artifact:read",
            "artifact:write",
            "stream:consume",
            "stream:produce"
          ]
        },
        "budget": {
          "mode": "reserve-before-invocation-created",
          "maxAttempts": 8,
          "maxDurationMs": 30000,
          "maxStateBytes": 2048,
          "maxArtifactBytes": 4096,
          "maxStreamItems": 8,
          "maxStreamInFlightBytes": 2048
        },
        "propagation": {
          "parentCancellation": "cancel-child-before-next-commit",
          "childFailure": "fail-call-edge-with-structured-failure",
          "childCancellation": "cancel-call-edge",
          "nonCooperativeChild": "retain-in-doubt-no-downstream-release",
          "parentFailureAfterChildCommit": "retain-child-history-no-implicit-reuse"
        },
        "recovery": {
          "resume": "continue-isolated-child-scope-from-events",
          "replay": "project-child-history-with-zero-dispatch",
          "fork": "new-child-scope-and-authority-decision",
          "successfulReuse": "exact-input-graph-plan-policy-and-committed-terminal"
        },
        "boundaryTransfer": {
          "artifacts": "explicit-authorized-artifact-ref-only",
          "streams": "new-descriptor-no-credit-ack-or-write-authority-inheritance"
        }
      }
    ],
    "reducers": [
      {
        "id": "collect-items",
        "graphKey": "child",
        "nodeId": "reduce",
        "statePointer": "/items",
        "contributors": [
          { "nodeId": "left", "outputPointer": "/value", "required": true },
          { "nodeId": "right", "outputPointer": "/value", "required": true }
        ],
        "operation": "ordered-append",
        "implementation": {
          "kind": "builtin",
          "version": "state-reducers/v1alpha1"
        },
        "law": "ordered-noncommutative",
        "initialState": { "mode": "required-invocation-state" },
        "conflictPolicy": "reject-overlap",
        "order": "contributor-declaration",
        "idempotency": "exact-batch",
        "validation": "state-schema-and-byte-bounds-before-cas",
        "commit": "event-stream-cas-and-state-version",
        "recovery": "fold-committed-batches-fork-copies-value-not-write-authority",
        "payloadPolicy": "requires-state-sink-policy/v1alpha1",
        "maxWrites": 2,
        "maxStateBytes": 2048,
        "maxUpdateBytes": 1024
      }
    ],
    "artifactEdges": [
      {
        "graphKey": "root",
        "edgeId": "e_nested_artifact",
        "maxBytes": 4096,
        "allowedMediaTypes": ["application/json"],
        "storageNamespace": "/tenants/fixture-tenant/runs/run-d4-contract",
        "tenantBinding": "fixture-tenant",
        "lifetime": "lineage",
        "integrity": "sha256-size/v1alpha1",
        "publication": "atomic-before-edge-release",
        "partialUploadCleanup": "bounded-idempotent-orphan-cleanup",
        "deduplication": "same-digest-size-media-type-and-tenant-only",
        "collision": "same-digest-different-bytes-is-fatal",
        "authorizationScope": "run-and-invocation",
        "producerCapabilities": ["artifact:write", "artifact:delete"],
        "consumerCapabilities": ["artifact:read"],
        "replayFork": "replay-read-only-fork-reauthorize-sharing",
        "supportExport": "metadata-only-unless-explicit-protected-export",
        "onError": "fail-edge",
        "requiredStoreContract": "artifact-store/v1alpha1",
        "requiredCapturePolicyContract": "artifact-sink-policy/v1alpha1"
      }
    ],
    "streamEdges": [
      {
        "graphKey": "root",
        "edgeId": "e_nested_stream",
        "itemMode": "value",
        "itemSchemaHash": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a",
        "topology": "one-to-one",
        "maxItems": 8,
        "maxItemBytes": 1024,
        "maxInFlightBytes": 2048,
        "bufferCapacity": 1,
        "maxUnacknowledged": 1,
        "maxDemandPerGrant": 2,
        "ordering": "source",
        "delivery": "at-least-once",
        "demand": "explicit-credit",
        "recovery": "redeliver-unacknowledged",
        "attemptIdentity": "stream-item-sequence-and-delivery-attempt",
        "lateItems": "reject-after-terminal",
        "terminalFrames": "exactly-one-success-error-or-cancel",
        "spillPolicy": "forbid",
        "checkpointBoundary": "after-every-durable-frame",
        "duplicateSuppression": "item-hash-sequence-and-ack-ledger",
        "traceMetrics": ["blockedNs", "lagItems", "queueDepth", "throughputItems"],
        "onError": "fail-edge",
        "onCancel": "cancel-edge",
        "requiredRuntimeContract": "durable-stream-edge/v1alpha1",
        "requiredCapturePolicyContract": "stream-sink-policy/v1alpha1"
      }
    ]
  },
