        },
        {
          "id": "left",
          "kind": "transform",
          "inputSchema": {},
          "outputSchema": {},
          "config": null
        },
        {
          "id": "right",
          "kind": "transform",
          "inputSchema": {},
          "outputSchema": {},
          "config": null
        },
        {
          "id": "reduce",
          "kind": "transform",
          "inputSchema": {},
          "outputSchema": {},
          "config": null
        }
      ],
      "edges": [
        {
          "id": "e_child_left",
          "from": { "node": "childStart" },
          "to": { "node": "left" },
          "mode": "value"
        },
        {
          "id": "e_child_right",
          "from": { "node": "childStart" },
          "to": { "node": "right" },
