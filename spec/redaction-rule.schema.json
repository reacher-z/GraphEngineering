{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha2/redaction-rule.schema.json",
  "title": "Graph Engineering Redaction Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "ruleId",
    "registryVersion",
    "sink",
    "paths",
    "replacementMode"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/redaction-rule/v1alpha2"
    },
    "ruleId": { "$ref": "#/$defs/identifier" },
    "registryVersion": { "$ref": "#/$defs/safePositiveInteger" },
    "sink": { "$ref": "capture-sink.schema.json" },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
      }
    },
    "replacementMode": { "enum": ["remove", "constant-token"] }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": { "enum": [".", ".."] }
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
