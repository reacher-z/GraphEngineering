{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha2/redaction-rule.schema.json",
  "title": "Graph Engineering Redaction Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "ruleId",
    "registryVersion",
    "sink",
    "paths",
    "replacementMode"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/redaction-rule/v1alpha2"
    },
    "ruleId": { "$ref": "#/$defs/identifier" },
    "registryVersion": { "$ref": "#/$defs/safePositiveInteger" },
    "sink": { "$ref": "capture-sink.schema.json" },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeJsonPointer" }
    },
    "replacementMode": { "enum": ["remove", "constant-token"] }
  },
  "$defs": {
    "safeJsonPointer": {
      "description": "An RFC 6901 JSON Pointer that traverses no prototype-bearing member. redaction-semantics.md declares prototype-property traversal normatively forbidden and the transform rejects it at apply time, but a poisoned rule can otherwise be stored in a policy and hashed into policyHash before any transform ever runs, so the prohibition is enforced here as well. A single literal check suffices: RFC 6901 escapes only '~' and '/', and none of __proto__, constructor or prototype contains either character, so each has exactly one spelling and no escaped variant can evade this pattern.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [
        { "pattern": "^(?:/(?:[^~/]|~[01])*)+$" },
        { "not": { "pattern": "(?:^|/)(?:__proto__|constructor|prototype)(?:/|$)" } }
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": { "enum": [".", ".."] }
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
