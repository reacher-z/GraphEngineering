{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-checkpoint.schema.json",
  "title": "Graph Engineering cycle-controller checkpoint and fold projection",
  "description": "Rebuildable projection cache for cycle-controller-recovery/v1alpha1. The authoritative source remains the validated event prefix named by lastSequence and historyPrefixHash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "controllerRunId",
    "hostRunId",
    "eventStreamId",
    "checkpointId",
    "lastSequence",
    "historyPrefixHash",
    "controllerHash",
    "requestHash",
    "graphRevision",
    "createdAt",
    "lease",
    "payloadDisposition",
    "redacted",
    "state",
    "contentHash"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/cycle-controller-checkpoints/v1alpha1"
    },
    "kind": { "const": "CycleControllerCheckpoint" },
    "controllerRunId": { "$ref": "#/$defs/identifier" },
    "hostRunId": { "$ref": "#/$defs/identifier" },
    "eventStreamId": { "$ref": "#/$defs/identifier" },
    "checkpointId": { "$ref": "#/$defs/identifier" },
    "lastSequence": { "$ref": "#/$defs/counter" },
    "historyPrefixHash": { "$ref": "#/$defs/hash" },
    "controllerHash": { "$ref": "#/$defs/hash" },
    "requestHash": { "$ref": "#/$defs/hash" },
    "graphRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "lease": {
      "oneOf": [
        {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/lease"
        },
        { "type": "null" }
      ]
    },
    "payloadDisposition": { "const": "inline-unredacted" },
    "redacted": { "const": false },
    "state": { "$ref": "#/$defs/foldState" },
    "contentHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "type": "object",
            "properties": { "status": { "const": "terminal" } },
            "required": ["status"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": { "lease": { "type": "null" } }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": { "enum": [".", ".."] }
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveCounter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cost": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "keyArray": {
      "type": "array",
      "maxItems": 10000000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservationId", "iteration", "maximum", "committed", "released", "remaining"],
      "properties": {
        "reservationId": { "$ref": "#/$defs/identifier" },
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "maximum": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/budgetDelta"
        },
        "committed": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/budgetDelta"
        },
        "released": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/budgetDelta"
        },
        "remaining": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/budgetDelta"
        }
      }
    },
    "openActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "reservationId",
        "phase",
        "activityId",
        "activityKey",
        "attempt",
        "sideEffects",
        "inputHash"
      ],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "reservationId": { "$ref": "#/$defs/identifier" },
        "phase": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/activityPhase"
        },
        "activityId": { "$ref": "#/$defs/identifier" },
        "activityKey": { "$ref": "#/$defs/hash" },
        "attempt": { "$ref": "#/$defs/positiveCounter" },
        "sideEffects": { "enum": ["none", "idempotent", "non-idempotent"] },
        "inputHash": { "$ref": "#/$defs/hash" }
      }
    },
    "discoveryProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateBatchHash", "candidateCount", "freshKeys", "duplicateKeys", "seenAdditions"],
      "properties": {
        "candidateBatchHash": { "$ref": "#/$defs/hash" },
        "candidateCount": { "$ref": "#/$defs/counter" },
        "freshKeys": { "$ref": "#/$defs/keyArray" },
        "duplicateKeys": {
          "type": "array",
          "maxItems": 100000,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "seenAdditions": { "$ref": "#/$defs/keyArray" }
      }
    },
    "evaluationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedKeys", "rejectedKeys", "unknownKeys"],
      "properties": {
        "acceptedKeys": { "$ref": "#/$defs/keyArray" },
        "rejectedKeys": { "$ref": "#/$defs/keyArray" },
        "unknownKeys": { "$ref": "#/$defs/keyArray" }
      }
    },
    "openRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "phase",
        "plan",
        "planHash",
        "reservationId",
        "openActivity",
        "discovery",
        "evaluation",
        "modeOutcome",
        "patchDecision"
      ],
      "properties": {
        "iteration": { "$ref": "#/$defs/positiveCounter" },
        "phase": {
          "enum": [
            "reserved",
            "running",
            "discovered",
            "evaluated",
            "mode-decided",
            "patch-decided",
            "failed",
            "cancelled"
          ]
        },
        "plan": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/roundPlan"
        },
        "planHash": { "$ref": "#/$defs/hash" },
        "reservationId": { "$ref": "#/$defs/identifier" },
        "openActivity": {
          "oneOf": [{ "$ref": "#/$defs/openActivity" }, { "type": "null" }]
        },
        "discovery": {
          "oneOf": [{ "$ref": "#/$defs/discoveryProjection" }, { "type": "null" }]
        },
        "evaluation": {
          "oneOf": [{ "$ref": "#/$defs/evaluationProjection" }, { "type": "null" }]
        },
        "modeOutcome": {
          "oneOf": [
            {
              "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/modeOutcome"
            },
            { "type": "null" }
          ]
        },
        "patchDecision": {
          "oneOf": [
            {
              "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/patchDecisionProjection"
            },
            { "type": "null" }
          ]
        }
      }
    },
    "patchRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patchId", "patchHash", "outcome", "decisionSequence"],
      "properties": {
        "patchId": { "$ref": "#/$defs/identifier" },
        "patchHash": { "$ref": "#/$defs/hash" },
        "outcome": { "enum": ["accepted", "rejected"] },
        "decisionSequence": { "$ref": "#/$defs/counter" }
      }
    },
    "foldState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "request",
        "requestHash",
        "controllerHash",
        "startedAt",
        "deadlineAt",
        "currentRevision",
        "status",
        "nextIteration",
        "seenKeys",
        "acceptedKeys",
        "rejectedKeys",
        "unknownKeys",
        "unevaluatedKeys",
        "consecutiveDryRounds",
        "attemptsUsed",
        "costUsd",
        "dynamicNodes",
        "durationMs",
        "liveReservations",
        "inDoubtActivities",
        "decidedPatches",
        "committedRounds",
        "openRound",
        "terminalObservation",
        "terminalResult"
      ],
      "properties": {
        "contractVersion": { "const": "cycle-controller-recovery/v1alpha1" },
        "request": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller.schema.json"
        },
        "requestHash": { "$ref": "#/$defs/hash" },
        "controllerHash": { "$ref": "#/$defs/hash" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "deadlineAt": { "$ref": "#/$defs/timestamp" },
        "currentRevision": {
          "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph-revision.schema.json#/$defs/coordinate"
        },
        "status": { "enum": ["active", "terminal"] },
        "nextIteration": { "$ref": "#/$defs/positiveCounter" },
        "seenKeys": { "$ref": "#/$defs/keyArray" },
        "acceptedKeys": { "$ref": "#/$defs/keyArray" },
        "rejectedKeys": { "$ref": "#/$defs/keyArray" },
        "unknownKeys": { "$ref": "#/$defs/keyArray" },
        "unevaluatedKeys": { "$ref": "#/$defs/keyArray" },
        "consecutiveDryRounds": { "$ref": "#/$defs/counter" },
        "attemptsUsed": { "$ref": "#/$defs/counter" },
        "costUsd": { "$ref": "#/$defs/cost" },
        "dynamicNodes": { "$ref": "#/$defs/counter" },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "liveReservations": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/reservation" }
        },
        "inDoubtActivities": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/openActivity" }
        },
        "decidedPatches": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/patchRecord" }
        },
        "committedRounds": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/roundRecord"
          }
        },
        "openRound": {
          "oneOf": [{ "$ref": "#/$defs/openRound" }, { "type": "null" }]
        },
        "terminalObservation": {
          "oneOf": [
            {
              "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/exitObservation"
            },
            { "type": "null" }
          ]
        },
        "terminalResult": {
          "oneOf": [
            {
              "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-result.schema.json"
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "terminal" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "openRound": { "type": "null" },
              "terminalResult": {
                "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-result.schema.json"
              },
              "terminalObservation": {
                "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/cycle-controller-event.schema.json#/$defs/exitObservation"
              },
              "liveReservations": { "type": "array", "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "terminalObservation": { "type": "null" },
              "terminalResult": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
