{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha2/protected-value.schema.json",
  "title": "Graph Engineering Protected Value Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "ref",
    "codec",
    "ciphertextHash",
    "valueMac",
    "keyRefHash",
    "aadHash"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/protected-value/v1alpha1"
    },
    "ref": {
      "type": "string",
      "pattern": "^pv_[A-Za-z0-9][A-Za-z0-9._-]{0,124}$",
      "not": { "enum": ["pv_.", "pv_.."] }
    },
    "codec": { "const": "durable-json/v1alpha1" },
    "ciphertextHash": { "$ref": "#/$defs/sha256" },
    "valueMac": { "$ref": "#/$defs/sha256" },
    "keyRefHash": { "$ref": "#/$defs/sha256" },
    "aadHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
