{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha2/event-v1alpha2.schema.json",
  "title": "Graph Engineering Protected Durable Scheduler Event v1alpha2",
  "description": "Closed authoritative scheduler-event subset. Observational redaction records use a separate guarded sink record and cannot be folded as scheduler authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "eventId",
    "type",
    "timestamp",
    "runId",
    "graphRevision",
    "sequence",
    "payloadHash",
    "capturePolicyHash",
    "redacted",
    "payloadDisposition",
    "data"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/events/v1alpha2"
    },
    "eventId": { "$ref": "#/$defs/identifier" },
    "type": {
      "enum": [
        "RunCreated",
        "RunStarted",
        "RunResumed",
        "NodeScheduled",
        "NodeStarted",
        "NodeAttemptFailed",
        "NodeSettledWithoutAttempt",
        "NodeRetried",
        "NodeSucceeded",
        "EdgeEmitted",
        "BarrierSatisfied",
        "RunCancelled",
        "RunFailed",
        "RunSucceeded"
      ]
    },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "runId": { "$ref": "#/$defs/identifier" },
    "graphRevision": { "$ref": "#/$defs/safePositiveInteger" },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "traceId": { "type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$" },
    "spanId": { "type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$" },
    "parentSpanId": { "type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$" },
    "nodeId": { "$ref": "#/$defs/identifier" },
    "edgeId": { "$ref": "#/$defs/identifier" },
    "attempt": { "$ref": "#/$defs/safePositiveInteger" },
    "payloadHash": { "$ref": "#/$defs/sha256" },
    "capturePolicyHash": { "$ref": "#/$defs/sha256" },
    "redacted": { "const": false },
    "payloadDisposition": { "enum": ["metadata-only", "protected-ref"] },
    "data": { "type": "object" }
  },
  "oneOf": [
    {
      "allOf": [
        { "$ref": "#/$defs/noNodeIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "RunCreated" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/runCreatedData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/noNodeIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "RunStarted" },
            "payloadDisposition": { "const": "metadata-only" },
            "data": { "$ref": "#/$defs/emptyData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/noNodeIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "RunResumed" },
            "payloadDisposition": { "const": "metadata-only" },
            "data": { "$ref": "#/$defs/runResumedData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/nodeAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "NodeScheduled" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/nodeScheduledData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/nodeAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "NodeStarted" },
            "payloadDisposition": { "const": "metadata-only" },
            "data": { "$ref": "#/$defs/nodeStartedData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/nodeAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "NodeAttemptFailed" },
            "payloadDisposition": { "const": "metadata-only" },
            "data": { "$ref": "#/$defs/nodeAttemptFailedMetadataData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/nodeAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "NodeAttemptFailed" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/nodeAttemptFailedProtectedData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/nodeWithoutAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "NodeSettledWithoutAttempt" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/nodeSettledData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/nodeAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "NodeRetried" },
            "payloadDisposition": { "const": "metadata-only" },
            "data": { "$ref": "#/$defs/nodeRetriedData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/nodeAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "NodeSucceeded" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/nodeSucceededData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/edgeAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "EdgeEmitted" },
            "payloadDisposition": { "const": "metadata-only" },
            "data": { "$ref": "#/$defs/edgeEmittedData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/nodeWithoutAttemptIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "BarrierSatisfied" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/barrierSatisfiedData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/noNodeIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "RunCancelled" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/runCancelledData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/noNodeIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "RunFailed" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/runFailedData" }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/noNodeIdentity" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "RunSucceeded" },
            "payloadDisposition": { "const": "protected-ref" },
            "data": { "$ref": "#/$defs/runSucceededData" }
          }
        }
      ]
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": { "enum": [".", ".."] }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "noNodeIdentity": {
      "type": "object",
      "properties": {
        "nodeId": false,
        "edgeId": false,
        "attempt": false
      }
    },
    "nodeAttemptIdentity": {
      "type": "object",
      "required": ["nodeId", "attempt"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "attempt": { "$ref": "#/$defs/safePositiveInteger" },
        "edgeId": false
      }
    },
    "nodeWithoutAttemptIdentity": {
      "type": "object",
      "required": ["nodeId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "edgeId": false,
        "attempt": false
      }
    },
    "edgeAttemptIdentity": {
      "type": "object",
      "required": ["nodeId", "edgeId", "attempt"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "edgeId": { "$ref": "#/$defs/identifier" },
        "attempt": { "$ref": "#/$defs/safePositiveInteger" }
      }
    },
    "emptyData": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "protectedPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "mac"],
      "properties": {
        "ref": { "$ref": "protected-value.schema.json" },
        "mac": { "$ref": "#/$defs/sha256" }
      }
    },
    "runCreatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "graphHash",
        "implementationHash",
        "inputRef",
        "inputMac",
        "capturePolicyHash",
        "protectedStoreContract",
        "keyRefHash",
        "maxTotalAttempts"
      ],
      "properties": {
        "contractVersion": { "const": "scheduler-recovery/v1alpha2" },
        "graphHash": { "$ref": "#/$defs/sha256" },
        "implementationHash": { "$ref": "#/$defs/sha256" },
        "inputRef": { "$ref": "protected-value.schema.json" },
        "inputMac": { "$ref": "#/$defs/sha256" },
        "capturePolicyHash": { "$ref": "#/$defs/sha256" },
        "protectedStoreContract": { "const": "protected-payload-store/v1alpha1" },
        "keyRefHash": { "$ref": "#/$defs/sha256" },
        "maxTotalAttempts": { "$ref": "#/$defs/safePositiveInteger" }
      }
    },
    "runResumedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reusedNodeIds", "interruptedNodeIds"],
      "properties": {
        "reusedNodeIds": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "interruptedNodeIds": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "nodeScheduledData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputRef", "inputMac", "activityKey", "sideEffects"],
      "properties": {
        "inputRef": { "$ref": "protected-value.schema.json" },
        "inputMac": { "$ref": "#/$defs/sha256" },
        "activityKey": { "$ref": "#/$defs/sha256" },
        "sideEffects": {
          "enum": ["none", "idempotent", "non-idempotent", "unspecified"]
        }
      }
    },
    "nodeStartedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputMac", "activityKey"],
      "properties": {
        "inputMac": { "$ref": "#/$defs/sha256" },
        "activityKey": { "$ref": "#/$defs/sha256" }
      }
    },
    "attemptFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "code", "messageTemplate", "retryable"],
      "properties": {
        "phase": { "const": "execute" },
        "code": {
          "enum": [
            "NODE_EXECUTION_FAILED",
            "NODE_TIMEOUT",
            "NODE_CANCELLED",
            "INVALID_OUTPUT",
            "NODE_EXECUTION_INTERRUPTED",
            "INVALID_ROUTE_SELECTION"
          ]
        },
        "messageTemplate": {
          "enum": [
            "node-execution-failed/v1",
            "node-timeout/v1",
            "node-cancelled/v1",
            "invalid-output/v1",
            "process-interrupted/v1",
            "invalid-route-selection/v1"
          ]
        },
        "retryable": { "type": "boolean" },
        "causeCode": {
          "enum": ["EXECUTOR_REJECTED", "TIMEOUT", "CANCELLED", "VALIDATION", "PROCESS_LOST", "ROUTER_CONTRACT"]
        }
      }
    },
    "nodeAttemptFailedMetadataData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal", "failure"],
      "properties": {
        "terminal": { "type": "boolean" },
        "failure": { "$ref": "#/$defs/attemptFailure" }
      }
    },
    "nodeAttemptFailedProtectedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal", "failure", "evidenceRef", "evidenceMac"],
      "properties": {
        "terminal": { "type": "boolean" },
        "failure": { "$ref": "#/$defs/attemptFailure" },
        "evidenceRef": { "$ref": "protected-value.schema.json" },
        "evidenceMac": { "$ref": "#/$defs/sha256" }
      }
    },
    "settledFailureCode": {
      "description": "Why a node settled without ever running an attempt. The last three members were added after the integrated-router and integrated-barrier lanes landed: both runtimes emit ROUTE_NOT_SELECTED, UNSUPPORTED_EDGE_CONDITION and UPSTREAM_UNKNOWN today, and this enum was frozen for a pre-router event set. There is deliberately no SETTLED_WITHOUT_FAILURE sentinel: a node that settled without failing has no failure code, so the member is absent rather than filled with a placeholder.",
      "enum": [
        "EXECUTOR_NOT_FOUND",
        "UPSTREAM_FAILED",
        "INPUT_BINDING_FAILED",
        "ATTEMPT_BUDGET_EXHAUSTED",
        "NODE_CANCELLED",
        "ROUTE_NOT_SELECTED",
        "UNSUPPORTED_EDGE_CONDITION",
        "UPSTREAM_UNKNOWN"
      ]
    },
    "nodeSettledData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultRef", "resultMac", "status", "attempts", "failureCode"],
      "properties": {
        "resultRef": { "$ref": "protected-value.schema.json" },
        "resultMac": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["failed", "skipped"] },
        "attempts": { "$ref": "#/$defs/safeNonNegativeInteger" },
        "failureCode": { "$ref": "#/$defs/settledFailureCode" }
      }
    },
    "nodeRetriedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availableAt", "activityKey"],
      "properties": {
        "availableAt": { "$ref": "#/$defs/timestamp" },
        "activityKey": { "$ref": "#/$defs/sha256" }
      }
    },
    "nodeSucceededData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputMac", "outputRef", "outputMac"],
      "properties": {
        "inputMac": { "$ref": "#/$defs/sha256" },
        "outputRef": { "$ref": "protected-value.schema.json" },
        "outputMac": { "$ref": "#/$defs/sha256" }
      }
    },
    "edgeEmittedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputMac"],
      "properties": {
        "outputMac": { "$ref": "#/$defs/sha256" }
      }
    },
    "barrierDecisionResolution": {
      "description": "The closed resolution set of barrier-decision.schema.json #/properties/resolution, mirrored inline because that schema lives in the v1alpha1 directory and this file resolves only same-directory references.",
      "enum": ["satisfied", "failed", "unknown", "awaiting_human"]
    },
    "barrierSatisfiedData": {
      "description": "One committed integrated-barrier decision. `decisionRef` protects the frozen barrier-decision.schema.json document (emitted for every committed decision, satisfied or not); the decision document is authoritative content and never appears inline. The closed inline projection carries the two domain-separated identities (`policyHash`, `decisionId`) and the two decision enums, and each MUST equal the same member of the protected document.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionRef",
        "decisionMac",
        "policyHash",
        "decisionId",
        "satisfied",
        "resolution"
      ],
      "properties": {
        "decisionRef": { "$ref": "protected-value.schema.json" },
        "decisionMac": { "$ref": "#/$defs/sha256" },
        "policyHash": { "$ref": "#/$defs/sha256" },
        "decisionId": { "$ref": "#/$defs/sha256" },
        "satisfied": { "type": "boolean" },
        "resolution": { "$ref": "#/$defs/barrierDecisionResolution" }
      }
    },
    "terminalData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultRef", "resultMac", "status"],
      "properties": {
        "resultRef": { "$ref": "protected-value.schema.json" },
        "resultMac": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["cancelled", "failed", "succeeded"] }
      }
    },
    "runCancelledData": {
      "allOf": [
        { "$ref": "#/$defs/terminalData" },
        { "type": "object", "properties": { "status": { "const": "cancelled" } } }
      ]
    },
    "runFailedData": {
      "allOf": [
        { "$ref": "#/$defs/terminalData" },
        { "type": "object", "properties": { "status": { "const": "failed" } } }
      ]
    },
    "runSucceededData": {
      "allOf": [
        { "$ref": "#/$defs/terminalData" },
        { "type": "object", "properties": { "status": { "const": "succeeded" } } }
      ]
    }
  }
}
