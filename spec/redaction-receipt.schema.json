{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha2/redaction-receipt.schema.json",
  "title": "Graph Engineering Bound Redaction Receipt",
  "description": "Closed audit carrier for one exact observational transform occurrence. Redaction is permitted only for observational values (redaction-semantics.md Sections 1.2, 2.2 and 2.3), so the eight authoritative 'protect, never redact' source classes and the three protected-store sinks are excluded from the receipt domain rather than left to prose. Hash joins and context equality are semantic requirements in redaction-semantics.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "policyHash",
    "sourceHash",
    "resultHash",
    "ruleSetHash",
    "transform",
    "transformImplementationHash",
    "ruleRegistryHash",
    "ruleRegistryVersion",
    "ruleResolutionId",
    "authorityBindingHash",
    "tenantScopeHash",
    "sourceClass",
    "sink",
    "decisionId",
    "runId",
    "graphRevision",
    "occurrenceKind",
    "occurrenceId",
    "occurrenceSequence",
    "occurredAt",
    "fieldPath",
    "paths",
    "replacementMode",
    "count"
  ],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/redaction-receipt/v1alpha2"
    },
    "policyHash": { "$ref": "#/$defs/sha256" },
    "sourceHash": { "$ref": "#/$defs/sha256" },
    "resultHash": { "$ref": "#/$defs/sha256" },
    "ruleSetHash": { "$ref": "#/$defs/sha256" },
    "transform": { "const": "json-pointer-rules/v1alpha2" },
    "transformImplementationHash": { "$ref": "#/$defs/sha256" },
    "ruleRegistryHash": { "$ref": "#/$defs/sha256" },
    "ruleRegistryVersion": { "$ref": "#/$defs/safePositiveInteger" },
    "ruleResolutionId": { "$ref": "#/$defs/identifier" },
    "authorityBindingHash": { "$ref": "#/$defs/sha256" },
    "tenantScopeHash": { "$ref": "#/$defs/sha256" },
    "sourceClass": {
      "allOf": [
        { "$ref": "capture-source.schema.json" },
        { "not": { "$ref": "#/$defs/neverRedactableSourceClass" } }
      ]
    },
    "sink": {
      "allOf": [
        { "$ref": "capture-sink.schema.json" },
        { "not": { "$ref": "#/$defs/neverRedactableSink" } }
      ]
    },
    "decisionId": { "$ref": "#/$defs/identifier" },
    "runId": { "$ref": "#/$defs/identifier" },
    "graphRevision": { "$ref": "#/$defs/safePositiveInteger" },
    "occurrenceKind": { "enum": ["event", "checkpoint", "sink-write"] },
    "occurrenceId": { "$ref": "#/$defs/identifier" },
    "occurrenceSequence": { "$ref": "#/$defs/safeNonNegativeInteger" },
    "occurredAt": { "$ref": "#/$defs/timestamp" },
    "fieldPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
      }
    },
    "replacementMode": { "enum": ["remove", "constant-token"] },
    "count": { "type": "integer", "minimum": 1, "maximum": 1024 }
  },
  "$defs": {
    "neverRedactableSourceClass": {
      "description": "redaction-semantics.md Section 1.2 row 1: authoritative; protect, never redact. Section 2.2 forbids redacted data from ever being authoritative, so no receipt may name one of these classes for any sink.",
      "enum": [
        "bound-node-input",
        "checkpoint-state",
        "event-data",
        "graph-input",
        "graph-output",
        "node-output",
        "node-result",
        "run-result"
      ]
    },
    "neverRedactableSink": {
      "description": "redaction-semantics.md Section 2.3: encryption is not redaction. The protected-store family carries authenticated ciphertext only and can never be the sink of an irreversible-transform receipt.",
      "enum": [
        "protected-blob-final",
        "protected-blob-memory",
        "protected-blob-temporary"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": { "enum": [".", ".."] }
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
