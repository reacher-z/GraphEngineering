{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph-patch.schema.json",
  "title": "Graph Engineering append-only graph patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "patchId", "base", "append"],
  "properties": {
    "apiVersion": {
      "const": "graphengineering.reacher-z.github.io/patches/v1alpha1"
    },
    "kind": { "const": "GraphPatch" },
    "patchId": { "$ref": "#/$defs/identifier" },
    "base": { "$ref": "#/$defs/base" },
    "append": { "$ref": "#/$defs/append" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphRevision", "graphHash", "revisionHash"],
      "properties": {
        "graphRevision": { "$ref": "#/$defs/baseRevision" },
        "graphHash": { "$ref": "#/$defs/hash" },
        "revisionHash": { "$ref": "#/$defs/hash" }
      }
    },
    "append": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "outputs"],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph.schema.json#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph.schema.json#/$defs/edge"
          }
        },
        "outputs": {
          "type": "object",
          "maxProperties": 10000,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "https://reacher-z.github.io/GraphEngineering/schemas/v1alpha1/graph.schema.json#/$defs/endpoint"
          }
        }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": { "nodes": { "type": "array", "minItems": 1 } }
        },
        {
          "type": "object",
          "properties": { "edges": { "type": "array", "minItems": 1 } }
        },
        {
          "type": "object",
          "properties": {
            "outputs": { "type": "object", "minProperties": 1 }
          }
        }
      ]
    }
  }
}
